:root {
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --accent-a: #ef4444;
    --accent-b: #3b82f6;
    --gold: #f59e0b;
    --text-light: #f8fafc;
    --text-muted: #94a3b8;
    --border-color: #334155;
    --radius: 16px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-light);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 100vh;
    padding: 12px;
}

.app-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
}

.game-header {
    text-align: center;
    padding: 16px 0;
    background: linear-gradient(135deg, #1e1b4b, #311b92);
    border-radius: var(--radius);
    margin-bottom: 16px;
}

.game-header h1 {
    font-size: 1.4rem;
    color: #fff;
}

.view { display: none; }
.active-view { display: block; }

.card {
    background-color: var(--card-bg);
    border-radius: var(--radius);
    padding: 20px;
    border: 1px solid var(--border-color);
}

.teams-overview {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.team-box {
    flex: 1;
    background-color: #0f172a;
    border-radius: 12px;
    padding: 12px;
    border: 1px solid var(--border-color);
}

.player-list {
    list-style: none;
    margin-bottom: 12px;
}

.player-list li {
    font-size: 0.8rem;
    padding: 6px 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    margin-bottom: 6px;
}

.btn {
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
}

.btn-primary { background-color: var(--gold); color: #000; }
.btn-large { padding: 14px; font-size: 1.05rem; }

.scoreboard {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--card-bg);
    border-radius: var(--radius);
    padding: 12px 20px;
    margin-bottom: 16px;
}

.score-num { font-size: 1.5rem; font-weight: 800; }
.team-a-score .score-num { color: var(--accent-a); }
.team-b-score .score-num { color: var(--accent-b); }

.phase-banner {
    background-color: var(--card-bg);
    border-radius: var(--radius);
    padding: 14px;
    text-align: center;
    margin-bottom: 16px;
    border-right: 4px solid var(--gold);
}

.hands-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 16px;
}

.hand-card {
    background-color: var(--card-bg);
    border-radius: var(--radius);
    padding: 16px;
    text-align: center;
    border: 2px solid var(--border-color);
    cursor: pointer;
}

.hand-icon { font-size: 2.5rem; margin-bottom: 8px; }
.hand-owner { font-size: 0.85rem; font-weight: 600; }
.hand-side { font-size: 0.75rem; color: var(--text-muted); }

.hand-card.revealed-empty { opacity: 0.4; }
.hand-card.revealed-diamond { border-color: var(--gold); background-color: rgba(245, 158, 11, 0.15); }
.status-msg { text-align: center; font-size: 0.9rem; color: var(--gold); }
